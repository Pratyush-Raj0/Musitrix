DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here
GUILD_ID=your_test_server_id_here
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview
# Optional: customize the assistant's system instructions.
# GEMINI_SYSTEM_PROMPT=You are a helpful assistant.

# Keep the real token in Replit Secrets or a local .env file.
# Never commit the actual Discord token to Git.
# Get a free Gemini API key at https://aistudio.google.com/apikey.
# Chat uses Gemini's native generateContent API.
